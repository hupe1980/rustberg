# Generated by packaging/homebrew/formula.sh for rustberg @VERSION@; do not edit.
class Rustberg < Formula
  desc "Policy-first Apache Iceberg REST catalog"
  homepage "https://hupe1980.github.io/rustberg/"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/hupe1980/rustberg/releases/download/v@VERSION@/rustberg-darwin-aarch64.tar.gz"
      sha256 "@SHA256_rustberg-darwin-aarch64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/hupe1980/rustberg/releases/download/v@VERSION@/rustberg-linux-aarch64.tar.gz"
      sha256 "@SHA256_rustberg-linux-aarch64@"
    end
    on_intel do
      url "https://github.com/hupe1980/rustberg/releases/download/v@VERSION@/rustberg-linux-x86_64.tar.gz"
      sha256 "@SHA256_rustberg-linux-x86_64@"
    end
  end

  def install
    # Each archive holds one binary named after its platform.
    bin.install Dir["rustberg-*"].first => "rustberg"
  end

  def caveats
    <<~EOS
      Try it with an ephemeral catalog and a printed admin key:
        rustberg --dev --insecure-http
      then open http://localhost:8000/ui/ and paste the key.
    EOS
  end

  test do
    assert_match "rustberg #{version}", shell_output("#{bin}/rustberg --version")
  end
end
