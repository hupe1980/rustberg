    "axe-core": "4.13.0",
    "happy-dom": "21.0.1",
    "puppeteer-core": "24.10.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.4"
  }
}
